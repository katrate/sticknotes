{
    "name": "sticknotes",
    "version": "1.2.2",
    "description": "Stick Notes - A simple desktop notes app",
    "main": "main.js",
    "author": {
        "name": "katrate",
        "email": "katrate@users.noreply.github.com"
    },
    "license": "MIT",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --publish never",
        "build:win": "electron-builder --win --publish never",
        "build:mac": "electron-builder --mac --publish never",
        "build:linux": "electron-builder --linux --publish never"
    },
    "build": {
        "appId": "com.katrate.sticknotes",
        "productName": "StickNotes",

        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "renderer.js",
            "index.html",
            "style.css",
            "icon.png"
        ],
        "win": {
            "target": ["nsis", "portable"],
            "icon": "icon.png"
        },
        "mac": {
            "target": ["dmg", "zip"],
            "icon": "icon.png",
            "category": "public.app-category.productivity"
        },
        "linux": {
            "target": ["AppImage", "deb"],
            "icon": "icon.png",
            "category": "Utility"
        }
    },
    "devDependencies": {
        "electron": "^28.3.3",
        "electron-builder": "^24.9.1"
    }
}
